GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_BOOTSTRAP_REDIRECT_BASE_URL=https://sidekick-github-bootstrap.onrender.com

# Optional workspace template repo
# GITHUB_BOOTSTRAP_TEMPLATE_OWNER=your-github-handle-or-org
# GITHUB_BOOTSTRAP_TEMPLATE_REPO=sidekick-workspace-template

# Optional repo policy overrides
# GITHUB_BOOTSTRAP_WORKSPACE_REPO_NAME=sidekick-workspace
# GITHUB_BOOTSTRAP_PROTECT_DEFAULT_BRANCH=true
# GITHUB_BOOTSTRAP_REQUIRE_PULL_REQUEST_REVIEWS=true
# GITHUB_BOOTSTRAP_REQUIRED_APPROVING_REVIEW_COUNT=1
# GITHUB_BOOTSTRAP_REQUIRE_LINEAR_HISTORY=true
# GITHUB_BOOTSTRAP_ENFORCE_ADMINS=true
# GITHUB_BOOTSTRAP_ALLOW_FORCE_PUSHES=false
# GITHUB_BOOTSTRAP_ALLOW_DELETIONS=false
